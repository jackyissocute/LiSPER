{"files": [{"id": 3951031, "name": "jp4122003_si_001.pdf", "size": 123939, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/3951031", "supplied_md5": "e9e58f049dde4d929c659a1ab92c3b20", "computed_md5": "e9e58f049dde4d929c659a1ab92c3b20", "mimetype": "application/pdf"}], "folder_structure": {}, "authors": [{"id": 151229, "full_name": "Xiaofeng Han", "first_name": "Xiaofeng", "last_name": "Han", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 589589, "full_name": "Yuwei Liu", "first_name": "Yuwei", "last_name": "Liu", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 1484743, "full_name": "Fu-Gen Wu", "first_name": "Fu-Gen", "last_name": "Wu", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 1831504, "full_name": "Joshua Jansensky", "first_name": "Joshua", "last_name": "Jansensky", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 79056, "full_name": "Taehoon Kim", "first_name": "Taehoon", "last_name": "Kim", "is_active": false, "url_name": "Taehoon_Kim", "orcid_id": ""}, {"id": 1831507, "full_name": "Zunliang Wang", "first_name": "Zunliang", "last_name": "Wang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 61231, "full_name": "Charles L. Brooks", "first_name": "Charles L.", "last_name": "Brooks", "is_active": false, "url_name": "Charles_L_Brooks", "orcid_id": ""}, {"id": 360829, "full_name": "Jianfeng Wu", "first_name": "Jianfeng", "last_name": "Wu", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 252337, "full_name": "Chuanwu Xi", "first_name": "Chuanwu", "last_name": "Xi", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 1831510, "full_name": "Charlene M. Mello", "first_name": "Charlene M.", "last_name": "Mello", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 488787, "full_name": "Zhan Chen", "first_name": "Zhan", "last_name": "Chen", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://acs.figshare.com/articles/journal_contribution/Different_Interfacial_Behaviors_of_Peptides_Chemically_Immobilized_on_Surfaces_with_Different_Linker_Lengths_and_via_Different_Termini/2313397", "download_disabled": false, "description": "Molecular structures such as conformation\nand orientation are crucial\nin determining the activity of peptides immobilized to solid supports.\nIn this study, sum frequency generation (SFG) vibrational spectroscopy\nwas applied to investigate such structures of peptides immobilized\non self-assembled monolayers (SAMs). Here cysteine-modified antimicrobial\npeptide cecropin P1 (CP1) was chemically immobilized onto SAM with\na maleimide terminal group. Two important characteristics, length\nof the poly\u00ad(ethylene glycol) (PEG) segment in the SAM and location\nof the cysteine residue in the peptide, were examined using SFG spectroscopy\nto determine the effect of each on surface immobilization as well\nas peptide secondary structure and its orientation in the immobilized\nstate. Results have shown that while each length of PEG chain studied\npromotes chemical immobilization of the target peptide and prevents\nnonspecific adsorption, CP1 immobilized on long-chain (PEG2k) maleimide\nSAMs shows random coil structure in water, whereas CP1 demonstrates\n\u03b1-helical structure when immobilized on short-chain (with four\nethylene glycol units - (EG4)) maleimide SAMs. Placement of the cysteine\nresidue at the C-terminus promotes the formation of \u03b1-helical\nstructure of CP1 with a single orientation when tethered to EG4 maleimide\nSAM surfaces. In contrast, immobilization via the N-terminal cysteine\nof CP1 results in a random coil or lying-down helical structure. The\nbacteria capturing/killing capability was tested, showing that the\nsurface-immobilized CP1 molecules via C- and N- terminal cysteine\nexhibit only slight difference, even though they have different secondary\nstructures and orientations.", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 123939, "created_date": "2016-02-17T23:44:38Z", "modified_date": "2023-06-17T22:02:48Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 10, "name": "CC BY-NC 4.0", "url": "https://creativecommons.org/licenses/by-nc/4.0/"}, "tags": ["terminal cysteine exhibit", "CP 1", "peptide", "EG 4 maleimide SAM surfaces", "Peptides Chemically Immobilized", "sum frequency generation", "Different Interfacial Behaviors", "SFG", "immobilization", "PEG 2k maleimide SAMs", "Different Linker Lengths", "maleimide terminal group", "CP 1 results", "helical", "orientation", "cysteine residue", "ethylene glycol units", "Different TerminiMolecular structures"], "keywords": ["terminal cysteine exhibit", "CP 1", "peptide", "EG 4 maleimide SAM surfaces", "Peptides Chemically Immobilized", "sum frequency generation", "Different Interfacial Behaviors", "SFG", "immobilization", "PEG 2k maleimide SAMs", "Different Linker Lengths", "maleimide terminal group", "CP 1 results", "helical", "orientation", "cysteine residue", "ethylene glycol units", "Different TerminiMolecular structures"], "categories": [{"id": 1, "title": "Biophysics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 4, "title": "Biochemistry", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 146, "title": "Space Science", "parent_id": 43, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 915, "title": "Physical Sciences not elsewhere classified", "parent_id": 6, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 21, "title": "Biotechnology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 272, "title": "Environmental Sciences not elsewhere classified", "parent_id": 33, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 873, "title": "Chemical Sciences not elsewhere classified", "parent_id": 38, "path": "