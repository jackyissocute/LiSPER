# Example env — locked-site umbrella on AMD EPYC 9554P (128 threads)
# Usage:  set -a; source launch_locked_site.env.example; set +a

export LISPER_REMOTE_ROOT=/data/LiSPER_remote
export PATH=/opt/gromacs/2026.0/bin:/usr/local/bin:$HOME/.local/bin:$PATH

# 128 threads − 4 reserve (SSH / WHAM / rsync)
export LISPER_GLOBAL_MDRUN_LIMIT=124
# Per-driver queue depth: set high so windows can fill the global 124-slot pool.
export LISPER_JOBS=124
# Pull = only 2 jobs → use many threads. Windows = 1 thread each × up to 124.
export LISPER_PULL_NTHREADS=60
export LISPER_NTHREADS=1
export LISPER_GLOBAL_MDRUN_LOCK=/tmp/lisper_gmx_mdrun.lock

# Protocol — do not change mid-campaign
export LISPER_PULL_NS=1.0
export LISPER_WINDOW_EQ_NS=0.5
export LISPER_WINDOW_NS=2.0
export LISPER_WINDOW_SPACING_NM=0.075
export LISPER_WINDOW_EXTENSION_NM=2.00
export LISPER_PULL_K=1000
export LISPER_GUARD_WINDOWS=3
export LISPER_UMB_SUBDIR=umbrella_sampling

# Per launch (edit):
# export LISPER_WORKDIR=$LISPER_REMOTE_ROOT/LiSPER_8cand_LiCl
# export LISPER_CANDIDATE=LiLC-1
# export LISPER_ION_RESNAME=LIT
# export LISPER_SITE_MANIFEST=$LISPER_REMOTE_ROOT/paired_binding_sites/LiLC-1.tsv
