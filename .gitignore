.DS_Store
**/.DS_Store

# Python bytecode
__pycache__/
*.py[cod]

# Editor backup files
**/#*#

# Large CHARMM-GUI system bundles are kept locally and mirrored to remote storage,
# but are not committed directly to GitHub.
01_computational_discovery/charmm-gui/*/systems/
01_computational_discovery/charmm-gui/*/raw_archives/

# MD trajectory files are kept locally or on remote storage, not in normal Git commits.
01_computational_discovery/md/**/remote_results/**/*.xtc
01_computational_discovery/md/**/remote_results/**/*.trr

# Active umbrella window workdirs contain bulky GROMACS binaries/logs and private
# absolute remote paths; preserve locally or on remote storage instead.
01_computational_discovery/umbrella/remote_results/**/gromacs/umbrella_sampling_binding_site_v2/

# Legacy mismatched-site umbrella/PMF binaries and raw curves: remote disk only.
# Keep machine-readable QC summaries (*.tsv) and docs in git; see pmf/LEGACY_DATA_EVALUATION.md.
